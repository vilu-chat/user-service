# Copy to .env for running outside Docker (flask run, flask db ..., pytest).
# The Postgres container comes from the parent docker-compose.yml (localhost:5432).
# Passwords must match USER_SVC_PASSWORD in ../.env and must be URL-safe.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://user_svc:change-me-user-svc@localhost:5432/user_service
TEST_DATABASE_URL=postgresql+psycopg://user_svc:change-me-user-svc@localhost:5432/user_service_test

# Auth stub from the parent docker-compose.yml (host port 8081).
KEYCLOAK_ISSUER=http://localhost:8081/realms/chat
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/chat/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=chat-api
